---
import { withBase } from '../lib/urls';

const navigation = [
  { href: withBase('/pro-zaklad/'), label: 'Про заклад' },
  { href: withBase('/#sports-education'), label: 'Напрямки спортивного виховання' },
  { href: withBase('/trenerskyi-sklad/'), label: 'Тренерський склад' },
  { href: withBase('/zmahannia/'), label: 'Змагання' },
  { href: withBase('/novyny/'), label: 'Новини' },
  { href: withBase('/dokumenty/'), label: 'Документи' },
  { href: withBase('/kontakty/'), label: 'Контакти' },
];

const currentPath = Astro.url.pathname;
const homePath = withBase('/');
const isCurrent = (href: string) => {
  const path = href.split('#')[0];
  return path !== homePath && (currentPath === path || currentPath.startsWith(path));
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homePath} aria-label="MDUSH Dnipro — на головну">
      <img class="brand-mark" src={withBase('/media/identity/mdush-mark.png')} alt="Емблема МДЮСШ" width="534" height="600" />
      <span class="brand-copy">
        <span class="brand-name">МДЮСШ ДНІПРО</span>
        <span class="brand-subtitle">З ігрових видів спорту Дніпровської міської ради</span>
      </span>
    </a>
    <div class="nav-shell">
      <input class="nav-toggle" id="main-nav-toggle" type="checkbox" aria-label="Відкрити або закрити меню" />
      <label class="nav-toggle-label" for="main-nav-toggle"><span>Меню</span><span class="menu-lines" aria-hidden="true"></span></label>
      <nav class="main-nav" aria-label="Основна навігація">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
