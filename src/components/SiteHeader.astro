---
import { withBase } from '../lib/urls';

const navigation = [
  { href: withBase('/'), label: 'Головна' },
  { href: withBase('/pro-zaklad/'), label: 'Про заклад' },
  { href: withBase('/sportyvni-napriamy/'), label: 'Спортивні напрями' },
  { href: withBase('/yak-vstupyty/'), label: 'Як вступити' },
  { href: withBase('/novyny/'), label: 'Новини' },
  { href: withBase('/kontakty/'), label: 'Контакти' },
];

const currentPath = Astro.url.pathname;
const homePath = withBase('/');
const isCurrent = (href: string) =>
  href === homePath ? currentPath === href : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homePath} aria-label="MDUSH Dnipro — на головну">
      <span class="brand-mark" aria-hidden="true">MD</span>
      <span>MDUSH Dnipro</span>
    </a>
    <div class="nav-shell">
      <input class="nav-toggle" id="main-nav-toggle" type="checkbox" />
      <label class="nav-toggle-label" for="main-nav-toggle">Меню</label>
      <nav class="main-nav" aria-label="Основна навігація">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
