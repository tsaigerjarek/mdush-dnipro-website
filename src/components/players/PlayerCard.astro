---
import type { Player } from '../../data/players';
import { withBase } from '../../lib/urls';

interface Props {
  player: Player;
}

const { player } = Astro.props;
---

<article class="player-card">
  <div class="player-card-media">
    {player.photoApprovedForPublicUse && player.photo ? (
      <img
        class="player-card-photo"
        src={withBase(player.photo)}
        alt={player.publicName}
        width="240"
        height="300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="player-card-placeholder" aria-label="Фото готується">
        <span class="placeholder-tag">Фото готується</span>
      </div>
    )}
  </div>
  <div class="player-card-content">
    <h6 class="player-card-name">{player.publicName}</h6>
    <p class="player-card-info">
      <span>{player.groupId}</span>
      {player.birthYear && <span>· {player.birthYear} р.н.</span>}
    </p>
    {(player.position || player.shirtNumber) && (
      <p class="player-card-role">
        {player.position && <span>{player.position}</span>}
        {player.shirtNumber && <span>{player.position ? ' · ' : ''}№ {player.shirtNumber}</span>}
      </p>
    )}
    {player.publicProfile && player.slug && (
      <a class="player-card-link" href={withBase(`/hravtsi/${player.slug}/`)}>
        Профіль гравця →
      </a>
    )}
  </div>
</article>
