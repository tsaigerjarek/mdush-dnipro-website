---
import type { WeeklyItem } from '../../data/weekly';
import { withBase } from '../../lib/urls';

interface Props {
  items: WeeklyItem[];
}

const { items } = Astro.props;

const typeLabels: Record<WeeklyItem['type'], string> = {
  match: 'МАТЧ',
  announcement: 'АНОНС',
  result: 'РЕЗУЛЬТАТ',
  gallery: 'ПОДІЯ',
  video: 'ВІДЕО',
};
---

<section class="section section--paper weekly-highlights-section event-slider-section" aria-labelledby="event-slider-heading">
  <div class="container">
    <div class="event-slider-header">
      <div class="event-slider-heading-wrap">
        <p class="eyebrow">Події та анонси закладу</p>
        <h2 id="event-slider-heading">Головне цього тижня</h2>
        <p class="event-slider-subtitle">
          Анонси матчів, події закладу, тренування та важливі матеріали МДЮСШ.
        </p>
      </div>
    </div>
  </div>

  <div class="event-slider-viewport-wrap">
    <div class="event-slider" id="event-slider">
      <div
        class="event-slider-stage"
        id="event-slider-stage"
        tabindex="0"
        role="region"
        aria-label="Слайдер подій та анонсів закладу"
      >
        {
          items.map((item, index) => (
            <article
              class={`event-slider-slide ${index === 0 ? 'is-active' : index === items.length - 1 ? 'is-prev' : index === 1 ? 'is-next' : 'is-hidden'}`}
              data-index={index}
              data-type={item.type}
              aria-roledescription="slide"
              aria-label={`${index + 1} з ${items.length}`}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <div class="event-slider-media">
                <img
                  class="event-slider-img"
                  src={withBase(item.image)}
                  alt={item.imageAlt}
                  width="1600"
                  height="900"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="event-slider-overlay" aria-hidden="true" />
              </div>

              <div class="event-slider-content">
                <div class="event-slider-meta">
                  <span class={`event-slider-badge event-slider-badge--${item.type}`}>
                    {typeLabels[item.type] || 'ПОДІЯ'}
                  </span>
                  {(item.date || item.time) && (
                    <div class="event-slider-datetime">
                      {item.date && <time class="event-slider-date">{item.date}</time>}
                      {item.date && item.time && <span class="event-slider-dot-separator">•</span>}
                      {item.time && <span class="event-slider-time">{item.time}</span>}
                    </div>
                  )}
                </div>

                <h3 class="event-slider-title">
                  {item.detailsUrl ? (
                    <a class="event-slider-title-link" href={withBase(item.detailsUrl)}>
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>

                <p class="event-slider-summary">{item.summary}</p>

                {item.detailsUrl && (
                  <div class="event-slider-actions">
                    <a class="button button-primary event-slider-cta" href={withBase(item.detailsUrl)}>
                      <span>Детальніше</span>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </a>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <nav class="event-slider-nav-bar" aria-label="Керування слайдером подій">
        <button
          type="button"
          class="event-slider-nav-btn event-slider-nav-btn--prev"
          id="event-slider-prev"
          aria-label="Попередня подія"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>

        <div class="event-slider-indicators" role="tablist" aria-label="Вибір події">
          {
            items.map((_, index) => (
              <button
                type="button"
                class={`event-slider-dot ${index === 0 ? 'is-active' : ''}`}
                data-slide-to={index}
                aria-label={`Перейти до події ${index + 1}`}
                aria-current={index === 0 ? 'true' : undefined}
              />
            ))
          }
        </div>

        <button
          type="button"
          class="event-slider-nav-btn event-slider-nav-btn--next"
          id="event-slider-next"
          aria-label="Наступна подія"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </nav>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const slider = document.getElementById('event-slider');
    if (!slider) return;

    const stage = document.getElementById('event-slider-stage');
    const prevBtn = document.getElementById('event-slider-prev');
    const nextBtn = document.getElementById('event-slider-next');
    const dots = Array.from(slider.querySelectorAll('.event-slider-dot'));
    const slides = Array.from(stage.querySelectorAll('.event-slider-slide'));
    const total = slides.length;

    if (!stage || !prevBtn || !nextBtn || total === 0) return;

    let currentIndex = 0;

    function renderSlots(index) {
      currentIndex = (index + total) % total;
      const prevIndex = (currentIndex - 1 + total) % total;
      const nextIndex = (currentIndex + 1) % total;

      slides.forEach((slide, i) => {
        slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-hidden');
        slide.removeAttribute('aria-current');

        if (i === currentIndex) {
          slide.classList.add('is-active');
          slide.setAttribute('aria-current', 'true');
        } else if (i === prevIndex) {
          slide.classList.add('is-prev');
        } else if (i === nextIndex) {
          slide.classList.add('is-next');
        } else {
          slide.classList.add('is-hidden');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('is-active');
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.classList.remove('is-active');
          dot.removeAttribute('aria-current');
        }
      });
    }

    function goTo(index) {
      renderSlots(index);
    }

    prevBtn.addEventListener('click', () => {
      goTo(currentIndex - 1);
    });

    nextBtn.addEventListener('click', () => {
      goTo(currentIndex + 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goTo(index);
      });
    });

    slides.forEach((slide) => {
      slide.addEventListener('click', (e) => {
        if (slide.classList.contains('is-prev')) {
          e.preventDefault();
          goTo(currentIndex - 1);
        } else if (slide.classList.contains('is-next')) {
          e.preventDefault();
          goTo(currentIndex + 1);
        }
      });
    });

    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(currentIndex + 1);
      }
    });

    let touchStartX = 0;
    let touchStartY = 0;
    stage.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches && e.touches[0]) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
        }
      },
      { passive: true },
    );

    stage.addEventListener(
      'touchend',
      (e) => {
        if (e.changedTouches && e.changedTouches[0]) {
          const deltaX = e.changedTouches[0].clientX - touchStartX;
          const deltaY = e.changedTouches[0].clientY - touchStartY;
          if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
            if (deltaX < 0) {
              goTo(currentIndex + 1);
            } else {
              goTo(currentIndex - 1);
            }
          }
        }
      },
      { passive: true },
    );

    renderSlots(0);
  })();
</script>
