---
import type { WeeklyItem } from '../../data/weekly';
import { withBase } from '../../lib/urls';

interface Props {
  event: WeeklyItem;
}

const { event } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="container home-hero-inner">
    <div class="home-hero-content">
      <div class="home-hero-badge-group">
        <span class="home-hero-live-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Офіційна інформація • Сезон 2026/2027</span>
        </span>
        <span class="home-hero-org">МДЮСШ ДНІПРО</span>
      </div>

      <h1 id="home-hero-title" class="home-hero-title">
        {event.title}
      </h1>

      <p class="home-hero-summary">
        {event.summary}
      </p>

      {(event.date || event.location) && (
        <div class="home-hero-meta-card">
          {event.date && (
            <div class="home-hero-meta-item">
              <svg class="meta-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span><strong>{event.date}</strong>{event.time ? ` • ${event.time}` : ''}</span>
            </div>
          )}

          {event.location && (
            <div class="home-hero-meta-item">
              <svg class="meta-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{event.location}</span>
            </div>
          )}
        </div>
      )}

      <div class="home-hero-actions">
        {event.primaryAction && (
          <a class="button button-primary home-hero-btn" href={withBase(event.primaryAction.href)}>
            {event.primaryAction.label}
          </a>
        )}
        {event.secondaryAction && (
          <a class="button button-outline home-hero-btn--secondary" href={withBase(event.secondaryAction.href)}>
            {event.secondaryAction.label}
          </a>
        )}
      </div>
    </div>

  </div>
</section>
