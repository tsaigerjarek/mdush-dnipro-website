---
import { withBase } from '../../lib/urls';

const pathwaySteps = [
  {
    title: 'Базова підготовка',
    subtitle: 'U9–U13 (від 9 до 13 років)',
    description: 'U9–U13 — навчальні групи (2014–2018 р.н.). Поступове збільшення навантажень, формування команд для участі у місцевих і регіональних турнірах.',
    actionLabel: 'Спортивні напрями',
    actionHref: '/sportyvni-napriamy/#football',
  },
  {
    title: 'Спеціалізована підготовка',
    subtitle: 'U14–U17 (від 14 до 17 років)',
    description: 'U14–U17 — футбольні команди / навчальні групи (2010–2013 р.н.). Удосконалення техніко-тактичних дій та участь у всеукраїнських змаганнях.',
    actionLabel: 'Змагання',
    actionHref: '/zmahannia/',
  },
  {
    title: 'ЗБІРНА U19',
    subtitle: '2008–2009 р.н.',
    description: 'Завершальний етап юнацької підготовки в системі МДЮСШ та перехід вихованців у дорослий аматорський або професійний футбол.',
    actionLabel: 'Тренерський склад',
    actionHref: '/trenerskyi-sklad/',
  },
];
---

<section class="section section--paper football-pathway-section" aria-labelledby="pathway-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Спортивна вертикаль закладу</p>
      <h2 id="pathway-title">Шлях розвитку юного футболіста у МДЮСШ</h2>
      <p class="section-lead">
        Послідовна методологія підготовки: від першого тренування у районній філії до старшого етапу спортивної школи.
      </p>
    </div>

    <div class="pathway-grid">
      {
        pathwaySteps.map((item, index) => (
          <article class="pathway-card">
            <div class="pathway-card-header">
              <h3 class="pathway-card-title">{item.title}</h3>
              {index < pathwaySteps.length - 1 && (
                <span class="pathway-connector-arrow" aria-hidden="true">→</span>
              )}
            </div>
            <p class="pathway-card-subtitle">{item.subtitle}</p>
            <p class="pathway-card-desc">{item.description}</p>
            <a class="pathway-action-link" href={withBase(item.actionHref)}>
              <span>{item.actionLabel}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
