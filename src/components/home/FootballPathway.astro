---
import { withBase } from '../../lib/urls';

const pathwaySteps = [
  {
    step: '01',
    title: 'Філії МДЮСШ',
    subtitle: 'Початковий етап',
    description: 'Початковий етап спортивної підготовки у районах міста Дніпро. Загальний фізичний розвиток, базова техніка володіння м’ячем та прищеплення любові до спорту.',
    actionLabel: 'Умови вступу',
    actionHref: '/yak-vstupyty/',
  },
  {
    step: '02',
    title: 'Ігрова практика',
    subtitle: 'Формати 4+1, 6+1, 8+1',
    description: 'Поетапний перехід від малих ігрових майданчиків до стандартного поля. Навчання командній взаємодії, футбольним правилам та ігровому мисленню.',
    actionLabel: 'Спортивні напрями',
    actionHref: '/sportyvni-napriamy/#football',
  },
  {
    step: '03',
    title: 'Розвиток і відбір',
    subtitle: 'Селекційний процес',
    description: 'Системний моніторинг спортивного прогресу вихованців тренерським складом. Формування юнацьких та дівочих збірних складів закладу.',
    actionLabel: 'Тренерський склад',
    actionHref: '/trenerskyi-sklad/',
  },
  {
    step: '04',
    title: 'Збірні команди',
    subtitle: 'Збірні МДЮСШ Дніпро',
    description: 'Участь в офіційних міських, обласних та всеукраїнських турнірах. Поглиблена тактична підготовка та змагальний досвід.',
    actionLabel: 'Календар і змагання',
    actionHref: '/zmahannia/',
  },
  {
    step: '05',
    title: 'Старший етап',
    subtitle: 'Випускні склади',
    description: 'Фінішний етап підготовки у спортивній школі. Тактична зрілість, спортивна дисципліна та перехід у дорослий футбол.',
    actionLabel: 'Про заклад',
    actionHref: '/pro-zaklad/',
  },
];
---

<section class="section section--paper football-pathway-section" aria-labelledby="pathway-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Спортивна вертикаль закладу</p>
      <h2 id="pathway-title">Шлях розвитку юного футболіста у МДЮСШ</h2>
      <p class="section-lead">
        Послідовна методологія підготовки: від першого тренування у районній філії до старшого етапу спортивної школи.
      </p>
    </div>

    <div class="pathway-grid">
      {
        pathwaySteps.map((item, index) => (
          <article class="pathway-card">
            <div class="pathway-card-header">
              <span class="pathway-step-num">{item.step}</span>
              {index < pathwaySteps.length - 1 && (
                <span class="pathway-connector-arrow" aria-hidden="true">→</span>
              )}
            </div>
            <h3 class="pathway-card-title">{item.title}</h3>
            <p class="pathway-card-subtitle">{item.subtitle}</p>
            <p class="pathway-card-desc">{item.description}</p>
            <a class="pathway-action-link" href={withBase(item.actionHref)}>
              <span>{item.actionLabel}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
