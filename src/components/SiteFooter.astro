---
import { withBase } from '../lib/urls';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <a class="brand" href={withBase('/')} aria-label="MDUSH Dnipro — на головну">
        <img class="brand-mark" src={withBase('/media/identity/mdush-logo-white.png')} alt="Емблема МДЮСШ" width="360" height="360" />
        <span class="brand-copy">
          <span class="brand-name">МДЮСШ ДНІПРО</span>
          <span class="brand-subtitle">З ігрових видів спорту Дніпровської міської ради</span>
        </span>
      </a>
      <p class="footer-description">МДЮСШ з ігрових видів спорту Дніпровської міської ради.</p>
      <address>
        <a href="tel:+380931131139">+380 93 113 1139</a><br />
        <a href="mailto:mdussdnepr@gmail.com">mdussdnepr@gmail.com</a>
      </address>
    </div>
    <div class="footer-links">
      <p class="footer-label">Навігація</p>
      <nav class="footer-nav" aria-label="Службова навігація">
        <ul>
          <li><a href={withBase('/#about')}>Про заклад</a></li>
          <li><a href={withBase('/sportyvni-napriamy/')}>Відділення</a></li>
          <li><a href={withBase('/yak-vstupyty/')}>Вступ</a></li>
          <li><a href={withBase('/prozorist/')}>Прозорість</a></li>
          <li><a href={withBase('/kontakty/')}>Контакти</a></li>
          <li><a href={withBase('/polityka-pryvatnosti/')}>Політика приватності</a></li>
          <li><a href={withBase('/pravyla-vykorystannia/')}>Правила використання</a></li>
        </ul>
      </nav>
    </div>
    <section class="footer-social" aria-labelledby="footer-social-title">
      <h2 id="footer-social-title" class="footer-social-title">Ми в соціальних мережах</h2>
      <p class="footer-social-intro">Офіційні посилання:</p>
      <ul class="social-links">
        <li>
          <a
            class="social-link"
            href="https://t.me/mdush_dnipro_official"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Офіційний Telegram МДЮСШ Дніпро"
          >
            <img class="social-logo" src={withBase('/media/social/telegram.png')} alt="" width="360" height="360" loading="lazy" />
            <span>Telegram</span>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="social-link"
            href="https://www.youtube.com/&#64;mdush_official_dnipro"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Офіційний YouTube МДЮСШ Дніпро"
          >
            <img class="social-logo" src={withBase('/media/social/youtube.png')} alt="" width="360" height="360" loading="lazy" />
            <span>YouTube</span>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="social-link"
            href="https://www.tiktok.com/&#64;mdush_official_dnipro?_t=8oGa0bOeSf7&amp;_r=1"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Офіційний TikTok МДЮСШ Дніпро"
          >
            <img class="social-logo" src={withBase('/media/social/tiktok.png')} alt="" width="360" height="360" loading="lazy" />
            <span>TikTok</span>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="social-link"
            href="https://www.instagram.com/mdush_official_dnipro/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Офіційний Instagram МДЮСШ Дніпро"
          >
            <img class="social-logo" src={withBase('/media/social/instagram.png')} alt="" width="360" height="360" loading="lazy" />
            <span>Instagram</span>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="social-link"
            href="https://www.facebook.com/mdush.ivs/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Офіційний Facebook МДЮСШ Дніпро"
          >
            <img class="social-logo" src={withBase('/media/social/facebook.png')} alt="" width="360" height="360" loading="lazy" />
            <span>Facebook</span>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</footer>
