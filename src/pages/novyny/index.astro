---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

const news = (await getCollection('news', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Новини — MDUSH Dnipro"
  description="Офіційні новини, оголошення та перевірені повідомлення про діяльність МДЮСШ Дніпро."
>
  <header class="page-intro"><p class="eyebrow">Офіційна інформація</p><h1>Новини</h1><p>Перевірені повідомлення про діяльність, спортивні напрями та можливості закладу.</p></header>
  <section class="section news-section">
    <div class="news-grid">
      {news.map((entry) => (
        <article class="news-card">
          <a class="news-card-media" href={withBase(`/novyny/${entry.id}/`)} aria-label={`Читати: ${entry.data.title}`}>
            <img src={withBase(entry.data.cover)} alt={entry.data.coverAlt} width="1600" height="900" loading="lazy" />
          </a>
          <div class="news-card-body">
            <time datetime={entry.data.publishedAt.toISOString()}>
              {entry.data.publishedAt.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <h2><a href={withBase(`/novyny/${entry.id}/`)}>{entry.data.title}</a></h2>
            <p>{entry.data.summary}</p>
            <a class="text-link" href={withBase(`/novyny/${entry.id}/`)}>Читати новину →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
