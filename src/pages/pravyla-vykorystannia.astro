---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Правила використання — MDUSH Dnipro"
  description="Статус підготовки правил використання офіційного сайту МДЮСШ Дніпро."
  robots="noindex, nofollow"
>
  <header class="page-intro">
    <p class="eyebrow">Службова інформація</p>
    <h1>Правила використання</h1>
    <p>Текст проходить юридичне погодження і буде доступний до публічного запуску сайту.</p>
  </header>
  <section class="section compact-section">
    <div class="notice" role="status">
      <h2>Поточний статус</h2>
      <p>Інформація на сайті готується як офіційне публічне джерело та проходить редакційну перевірку перед розміщенням.</p>
    </div>
  </section>
</BaseLayout>
