---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const latestNews = (await getCollection('news', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="МДЮСШ Дніпро — офіційний сайт"
  description="Офіційна інформація про МДЮСШ Дніпро, спортивні напрями, порядок вступу, новини, контакти та години роботи."
  fullWidth
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Комунальний позашкільний навчальний заклад</p>
        <h1>МДЮСШ з ігрових видів спорту</h1>
        <p>Спортивний заклад Дніпровської міської ради для систематичних занять дітей, підлітків і молоді фізичною культурою та спортом.</p>
        <div class="actions">
          <a class="button" href={withBase('/yak-vstupyty/')}>Як вступити</a>
          <a class="button button-secondary" href={withBase('/sportyvni-napriamy/')}>Спортивні напрями</a>
        </div>
        <dl class="hero-facts" aria-label="Коротко про заклад">
          <div><dt>03</dt><dd>спортивні напрями</dd></div>
          <div><dt>10</dt><dd>футбольних груп</dd></div>
          <div><dt>26/27</dt><dd>сезон 2026/2027</dd></div>
        </dl>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="hero-art-ring hero-art-ring--outer"></span>
        <span class="hero-art-ring hero-art-ring--inner"></span>
        <img class="hero-mark" src={withBase('/media/identity/mdush-mark.png')} alt="" width="534" height="600" />
        <span class="hero-art-label">ДНІПРО<br />СПОРТ</span>
      </div>
    </div>
  </section>

  <section class="section section--paper directions-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Напрями</p>
        <h2>Три види спорту — один заклад</h2>
        <p>У сезоні 2026/2027 заклад представляє футбол, настільний теніс і черлідинг.</p>
      </div>
      <div class="grid directions-grid">
        <article class="card direction-card direction-card--football"><img class="direction-card-art" src={withBase('/media/identity/athlete-football.png')} alt="" width="1511" height="1660" loading="lazy" /><span class="card-number">01</span><h3>Футбол</h3><p>Десять підтверджених груп: від U12 до U19.</p><a class="text-link" href={withBase('/sportyvni-napriamy/')}>Детальніше <span aria-hidden="true">↗</span></a></article>
        <article class="card direction-card direction-card--tennis"><img class="direction-card-art" src={withBase('/media/identity/athlete-tennis.png')} alt="" width="1693" height="1693" loading="lazy" /><span class="card-number">02</span><h3>Настільний теніс</h3><p>Окремий спортивний напрям МДЮСШ.</p><a class="text-link" href={withBase('/sportyvni-napriamy/')}>Детальніше <span aria-hidden="true">↗</span></a></article>
        <article class="card direction-card direction-card--cheerleading"><img class="direction-card-art" src={withBase('/media/identity/athlete-cheerleading.png')} alt="" width="1434" height="1434" loading="lazy" /><span class="card-number">03</span><h3>Черлідинг</h3><p>Окремий спортивний напрям МДЮСШ.</p><a class="text-link" href={withBase('/sportyvni-napriamy/')}>Детальніше <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>

  <section class="section section--tint news-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Офіційна інформація</p>
        <h2>Останні новини</h2>
      </div>
      <div class="news-grid">
        {latestNews.map((entry) => (
          <article class="news-card">
            <a class="news-card-media" href={withBase(`/novyny/${entry.id}/`)} aria-label={`Читати: ${entry.data.title}`}>
              <img src={withBase(entry.data.cover)} alt={entry.data.coverAlt} width="1600" height="900" loading="lazy" />
            </a>
            <div class="news-card-body">
              <time datetime={entry.data.publishedAt.toISOString()}>
                {entry.data.publishedAt.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <h3><a href={withBase(`/novyny/${entry.id}/`)}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
              <a class="text-link" href={withBase(`/novyny/${entry.id}/`)}>Читати новину →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper home-guide-section" aria-labelledby="home-guide-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Перевірена інформація</p>
        <h2 id="home-guide-title">Що вже можна перевірити на сайті</h2>
        <p>Перша версія сайту зібрана як офіційна точка входу: без онлайн-форм, без кабінетів і без збору персональних даних дітей.</p>
      </div>
      <div class="home-guide-grid">
        <a class="home-guide-card" href={withBase('/pro-zaklad/')}>
          <span class="card-number">01</span>
          <h3>Про заклад</h3>
          <p>Юридична назва, статус, освітня функція та роль МДЮСШ у системі позашкільної спортивної освіти.</p>
        </a>
        <a class="home-guide-card" href={withBase('/sportyvni-napriamy/')}>
          <span class="card-number">02</span>
          <h3>Спортивні відділення</h3>
          <p>Футбол, настільний теніс, черлідинг і перелік навчально-тренувальних баз із перевіреними адресами.</p>
        </a>
        <a class="home-guide-card" href={withBase('/yak-vstupyty/')}>
          <span class="card-number">03</span>
          <h3>Вступ</h3>
          <p>Перші кроки звернення для батьків без передачі документів дитини через відкриті канали.</p>
        </a>
        <a class="home-guide-card" href={withBase('/prozorist/')}>
          <span class="card-number">04</span>
          <h3>Прозорість</h3>
          <p>Статус відкритої інформації, правила публікації документів і межі того, що не виноситься на сайт.</p>
        </a>
      </div>
      <p class="section-note">Для уточнення умов вступу, наявності місць або організаційних питань використовуйте розділ <a class="contact-link" href={withBase('/kontakty/')}>«Контакти»</a>.</p>
    </div>
  </section>

  <section class="section band next-step-section">
    <div class="container next-step-inner">
      <div>
        <p class="eyebrow">Для батьків</p>
        <h2>Зрозумілий шлях до першого звернення</h2>
      </div>
      <div class="next-step-copy">
        <p>Оберіть напрям і зверніться до адміністрації, щоб уточнити актуальні умови та наявність місць. Сайт не збирає персональні дані дитини.</p>
        <a class="button" href={withBase('/yak-vstupyty/')}>Перейти до розділу <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
