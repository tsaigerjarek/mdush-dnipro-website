---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const latestNews = (await getCollection('news', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="МДЮСШ Дніпро — офіційний сайт"
  description="Офіційний сайт МДЮСШ Дніпро: футбол, черлідинг і настільний теніс, вступ, змагання, новини, документи та контакти."
  fullWidth
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Комунальний позашкільний навчальний заклад</p>
        <h1>МДЮСШ з ігрових видів спорту</h1>
        <p>Заклад об’єднує три спортивні напрями: основний — футбол, другий — черлідинг, третій — настільний теніс.</p>
        <div class="actions">
          <a class="button" href="#admission">Умови вступу</a>
          <a class="button button-secondary" href="#sports">Напрямки спортивного виховання</a>
        </div>
        <dl class="hero-facts" aria-label="Коротко про заклад">
          <div><dt>01</dt><dd>футбол — основний напрям</dd></div>
          <div><dt>02</dt><dd>черлідинг — підтримка команд</dd></div>
          <div><dt>03</dt><dd>настільний теніс</dd></div>
        </dl>
      </div>
      <div class="hero-visual">
        <picture>
  <source media="(max-width: 767px)" type="image/png" srcset={withBase('/media/hero/hero-mdush-mobile.png')} />
  <source media="(max-width: 1199px)" type="image/png" srcset={withBase('/media/hero/hero-mdush-tablet.png')} />
  <source type="image/png" srcset={withBase('/media/hero/hero-mdush-desktop.png')} />
          <img
            src={withBase('/media/hero/hero-mdush-fallback.jpg')}
            alt="Вихованці трьох спортивних напрямів МДЮСШ Дніпро: футболу, черлідингу та настільного тенісу"
            width="1920"
            height="1080"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <section id="about" class="section section--tint home-official-section" aria-labelledby="about-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <p class="eyebrow">Про заклад</p>
        <h2 id="about-title">Офіційний заклад позашкільної освіти у сфері спорту</h2>
        <p>Міський дитячо-юнацький спортивний заклад Дніпра забезпечує спортивну підготовку дітей та молоді за напрямами футболу, черліденгу і настільного тенісу.</p>
      </div>
      <dl class="home-facts" aria-label="Ключова інформація про заклад">
        <div><dt>01</dt><dd>Комунальний заклад міста Дніпра</dd></div>
        <div><dt>02</dt><dd>Підготовка дітей та молоді</dd></div>
        <div><dt>03</dt><dd>Три спортивні напрями</dd></div>
      </dl>
      <div class="actions home-section-action">
        <a class="button" href={withBase('/pro-zaklad/')}>Про заклад</a>
      </div>
    </div>
  </section>

  <section id="admission" class="section section--paper home-admission-section" aria-labelledby="admission-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <p class="eyebrow">Вступ</p>
        <h2 id="admission-title">Як вступити до МДЮСШ</h2>
        <p>Вступ починається з вибору спортивного напряму, ознайомлення з умовами набору та звернення до адміністрації закладу.</p>
      </div>
      <ol class="home-admission-steps">
        <li>
          <article class="card home-admission-card">
            <span class="card-number">01</span>
            <h3>Обрати спортивний напрям</h3>
          </article>
        </li>
        <li>
          <article class="card home-admission-card">
            <span class="card-number">02</span>
            <h3>Перевірити вікову групу та умови набору</h3>
          </article>
        </li>
        <li>
          <article class="card home-admission-card">
            <span class="card-number">03</span>
            <h3>Підготувати необхідні документи</h3>
          </article>
        </li>
        <li>
          <article class="card home-admission-card">
            <span class="card-number">04</span>
            <h3>Зв’язатися з адміністрацією закладу</h3>
          </article>
        </li>
      </ol>
      <div class="actions home-section-action">
        <a class="button" href={withBase('/yak-vstupyty/')}>Переглянути умови вступу</a>
      </div>
    </div>
  </section>

  <section id="sports-education" class="section section--tint home-sports-section" aria-labelledby="sports-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <p class="eyebrow">Спортивне виховання</p>
        <h2 id="sports-title">Напрямки спортивного виховання</h2>
      </div>
      <div id="sports" class="home-sports-grid">
        <article class="card home-sport-card">
          <span class="card-number">01</span>
          <p class="direction-role">Основний напрям</p>
          <h3>Футбол</h3>
          <p>Основний напрям спортивної підготовки закладу.</p>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Переглянути напрям →</a>
        </article>
        <article class="card home-sport-card home-sport-card--warm">
          <span class="card-number">02</span>
          <p class="direction-role">Другий напрям</p>
          <h3>Черліденг</h3>
          <p>Другий напрям і підтримка футбольних команд на домашніх змаганнях.</p>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Переглянути напрям →</a>
        </article>
        <article class="card home-sport-card home-sport-card--dark">
          <span class="card-number">03</span>
          <p class="direction-role">Третій напрям</p>
          <h3>Настільний теніс</h3>
          <p>Третій напрям спортивного виховання закладу.</p>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Переглянути напрям →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--paper competitions-preview" aria-labelledby="competitions-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <p class="eyebrow">Змагання</p>
        <h2 id="competitions-title">Один календар для трьох напрямів</h2>
        <p>Публікуються тільки підтверджені дати, час, місце проведення, суперник або назва турніру та статус трансляції.</p>
      </div>
      <div class="information-grid">
        <article class="information-card">
          <span class="card-number">01</span>
          <h3>Футбол</h3>
          <p>Матчі команд МДЮСШ, результати, турніри та посилання на офіційні трансляції після підтвердження.</p>
        </article>
        <article class="information-card information-card--cheerleading">
          <span class="card-number">02</span>
          <h3>Черлідинг</h3>
          <p>Участь у профільних змаганнях і підтримка футбольних команд під час домашніх матчів.</p>
        </article>
        <article class="information-card information-card--tennis">
          <span class="card-number">03</span>
          <h3>Настільний теніс</h3>
          <p>Турніри, календар виступів і підтверджені результати вихованців.</p>
        </article>
      </div>
      <div class="actions home-section-action">
        <a class="button" href={withBase('/zmahannia/')}>Перейти до змагань</a>
      </div>
    </div>
  </section>

  <section class="section section--tint home-coaches-section" aria-labelledby="coaches-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <p class="eyebrow">Команда фахівців</p>
        <h2 id="coaches-title">Тренери за спортивними напрямами</h2>
        <p>Офіційний перелік тренерів закладу буде публікуватися після звірки посад, спортивних напрямів і вікових груп з адміністрацією.</p>
      </div>
      <div class="information-grid">
        <article class="information-card">
          <span class="card-number">01</span>
          <h3>Футбол</h3>
          <p>Тренерські штаби команд за віковими групами, роль кожного фахівця та локація тренувань.</p>
        </article>
        <article class="information-card information-card--tennis">
          <span class="card-number">02</span>
          <h3>Настільний теніс</h3>
          <p>Тренери відділення, навчальні групи та коротка інформація про спортивну підготовку.</p>
        </article>
        <article class="information-card information-card--cheerleading">
          <span class="card-number">03</span>
          <h3>Черлідинг</h3>
          <p>Тренери, вікові групи, напрями підготовки та участь у спортивних заходах.</p>
        </article>
      </div>
      <div class="actions home-section-action">
        <a class="button" href={withBase('/trenerskyi-sklad/')}>Перейти до тренерського складу</a>
      </div>
    </div>
  </section>

  <section class="section section--paper news-section" aria-labelledby="news-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Офіційний Telegram-канал</p>
        <h2 id="news-title">Новини закладу</h2>
        <p>Розділ дублює перевірені публікації офіційного Telegram-каналу МДЮСШ і зберігає їх на сайті як доступний архів.</p>
      </div>
      <div class="news-grid">
        {latestNews.map((entry) => (
          <article class="news-card">
            <a class="news-card-media" href={withBase(`/novyny/${entry.id}/`)} aria-label={`Читати: ${entry.data.title}`}>
              <img src={withBase(entry.data.cover)} alt={entry.data.coverAlt} width="1600" height="900" loading="lazy" />
            </a>
            <div class="news-card-body">
              <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              <h3><a href={withBase(`/novyny/${entry.id}/`)}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
              <a class="text-link" href={withBase(`/novyny/${entry.id}/`)}>Читати новину →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="section-note">Першоджерело оперативних публікацій — офіційний Telegram-канал закладу.</p>
      <div class="actions home-section-action">
        <a class="button" href={withBase('/novyny/')}>Усі новини</a>
      </div>
    </div>
  </section>

  <section class="section band next-step-section">
    <div class="container next-step-inner">
      <div><p class="eyebrow">Документи</p><h2>Документи закладу у відкритому доступі</h2></div>
      <div class="next-step-copy">
        <p>На сайті публікуються установчі, організаційні, освітні та інші відкриті документи. Фінансові документи до публічного каталогу не включаються.</p>
        <a class="button" href={withBase('/dokumenty/')}>Відкрити документи <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
