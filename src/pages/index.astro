---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const latestNews = (await getCollection('news', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="МДЮСШ Дніпро — офіційний сайт"
  description="Офіційна інформація про МДЮСШ Дніпро, спортивні напрями, порядок вступу, новини, контакти та години роботи."
  fullWidth
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Комунальний позашкільний навчальний заклад</p>
      <h1>МДЮСШ з ігрових видів спорту</h1>
      <p>Спортивний заклад Дніпровської міської ради для систематичних занять дітей, підлітків і молоді фізичною культурою та спортом.</p>
      <div class="actions">
        <a class="button" href={withBase('/yak-vstupyty/')}>Як вступити</a>
        <a class="button button-secondary" href={withBase('/sportyvni-napriamy/')}>Спортивні напрями</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Напрями</p>
        <h2>Три види спорту — один заклад</h2>
        <p>У сезоні 2026/2027 заклад представляє футбол, настільний теніс і черлідинг.</p>
      </div>
      <div class="grid">
        <article class="card"><span class="card-number">01</span><h3>Футбол</h3><p>Десять підтверджених груп: від U12 до U19.</p></article>
        <article class="card"><span class="card-number">02</span><h3>Настільний теніс</h3><p>Окремий спортивний напрям МДЮСШ.</p></article>
        <article class="card"><span class="card-number">03</span><h3>Черлідинг</h3><p>Окремий спортивний напрям МДЮСШ.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Офіційна інформація</p>
        <h2>Останні новини</h2>
      </div>
      <div class="news-grid">
        {latestNews.map((entry) => (
          <article class="news-card">
            <a class="news-card-media" href={withBase(`/novyny/${entry.id}/`)} aria-label={`Читати: ${entry.data.title}`}>
              <img src={withBase(entry.data.cover)} alt={entry.data.coverAlt} width="1600" height="900" loading="lazy" />
            </a>
            <div class="news-card-body">
              <time datetime={entry.data.publishedAt.toISOString()}>
                {entry.data.publishedAt.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <h3><a href={withBase(`/novyny/${entry.id}/`)}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
              <a class="text-link" href={withBase(`/novyny/${entry.id}/`)}>Читати новину →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow">Для батьків</p>
      <h2>Зрозумілий шлях до першого звернення</h2>
      <p>Оберіть напрям і зверніться до адміністрації, щоб уточнити актуальні умови та наявність місць. Сайт не збирає персональні дані дитини.</p>
      <a class="button" href={withBase('/yak-vstupyty/')}>Перейти до розділу</a>
    </div>
  </section>
</BaseLayout>
