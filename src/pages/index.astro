---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const latestNews = (await getCollection('news', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="МДЮСШ Дніпро — офіційний сайт"
  description="Офіційний сайт МДЮСШ Дніпро: футбол, черлідинг і настільний теніс, вступ, змагання, новини, документи та контакти."
  fullWidth
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Комунальний позашкільний навчальний заклад</p>
        <h1>МДЮСШ з ігрових видів спорту</h1>
        <p>Заклад об’єднує три спортивні напрями: основний — футбол, другий — черлідинг, третій — настільний теніс.</p>
        <div class="actions">
          <a class="button" href="#admission">Як вступити</a>
          <a class="button button-secondary" href="#sports">Спортивні напрями</a>
        </div>
        <dl class="hero-facts" aria-label="Коротко про заклад">
          <div><dt>01</dt><dd>футбол — основний напрям</dd></div>
          <div><dt>02</dt><dd>черлідинг — підтримка команд</dd></div>
          <div><dt>03</dt><dd>настільний теніс</dd></div>
        </dl>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="hero-art-ring hero-art-ring--outer"></span>
        <span class="hero-art-ring hero-art-ring--inner"></span>
        <img class="hero-mark" src={withBase('/media/identity/mdush-mark.png')} alt="" width="534" height="600" />
        <span class="hero-art-label">ДНІПРО<br />СПОРТ</span>
      </div>
    </div>
  </section>

  <section id="about" class="section section--tint home-about-section" aria-labelledby="about-title">
    <div class="container home-about-grid">
      <div class="section-heading">
        <p class="eyebrow">Про заклад</p>
        <h2 id="about-title">Спортивна освіта, підготовка і змагальна практика</h2>
      </div>
      <div>
        <p>МДЮСШ Дніпро — комунальний позашкільний навчальний заклад спортивного профілю. Заклад проводить навчально-тренувальну, спортивну та організаційно-масову роботу з дітьми, підлітками й молоддю.</p>
        <a class="text-link" href={withBase('/pro-zaklad/')}>Повна офіційна інформація про заклад →</a>
      </div>
    </div>
  </section>

  <section id="sports" class="section section--paper directions-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Спортивні напрями</p>
        <h2>Три напрями з чіткою роллю в системі закладу</h2>
        <p>Футбол формує основну спортивну програму МДЮСШ. Черлідинг розвивається як окремий напрям і підтримує футбольні команди під час домашніх змагань. Настільний теніс є третім напрямом закладу.</p>
      </div>
      <div class="sports-priority-grid">
        <article class="card direction-card direction-card--football direction-card--primary">
          <img class="direction-card-art" src={withBase('/media/identity/athlete-football.png')} alt="" width="1511" height="1660" loading="lazy" />
          <span class="card-number">01</span>
          <p class="direction-role">Основний напрям</p>
          <h3>Футбол</h3>
          <p>Підготовка команд різних вікових груп, участь у чемпіонатах і турнірах, розвиток гравців від базового етапу до старших груп.</p>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Команди, групи та бази →</a>
        </article>
        <article class="card direction-card direction-card--cheerleading">
          <img class="direction-card-art" src={withBase('/media/identity/athlete-cheerleading.png')} alt="" width="1434" height="1434" loading="lazy" />
          <span class="card-number">02</span>
          <p class="direction-role">Другий напрям</p>
          <h3>Черлідинг</h3>
          <p>Самостійна спортивна підготовка та організована підтримка футбольних команд МДЮСШ під час домашніх змагань чемпіонату України.</p>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Про напрям →</a>
        </article>
        <article class="card direction-card direction-card--tennis">
          <img class="direction-card-art" src={withBase('/media/identity/athlete-tennis.png')} alt="" width="1693" height="1693" loading="lazy" />
          <span class="card-number">03</span>
          <p class="direction-role">Третій напрям</p>
          <h3>Настільний теніс</h3>
          <p>Тренування, технічна підготовка та участь вихованців у профільних змаганнях.</p>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Про напрям →</a>
        </article>
      </div>
    </div>
  </section>

  <section id="admission" class="section section--tint admission-overview" aria-labelledby="admission-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Як вступити</p>
        <h2 id="admission-title">Три кроки до першого звернення</h2>
        <p>Сайт не збирає документи або персональні дані дитини. Умови вступу та наявність місць уточнюються через офіційні контакти закладу.</p>
      </div>
      <div class="information-grid">
        <article class="information-card"><span class="card-number">01</span><h3>Оберіть напрям</h3><p>Футбол, черлідинг або настільний теніс.</p></article>
        <article class="information-card"><span class="card-number">02</span><h3>Уточніть групу</h3><p>Зверніться до адміністрації щодо віку, місця тренувань і наявності місць.</p></article>
        <article class="information-card"><span class="card-number">03</span><h3>Підготуйте документи</h3><p>Передавайте документи лише за офіційно погодженою процедурою, не через відкриті повідомлення.</p></article>
      </div>
      <div class="actions"><a class="button" href={withBase('/yak-vstupyty/')}>Повна інструкція</a><a class="button button-secondary button-on-light" href={withBase('/kontakty/')}>Контакти</a></div>
    </div>
  </section>

  <section class="section section--paper competitions-preview" aria-labelledby="competitions-title">
    <div class="container home-about-grid">
      <div class="section-heading">
        <p class="eyebrow">Змагання</p>
        <h2 id="competitions-title">Календар, результати та участь усіх напрямів</h2>
      </div>
      <div>
        <p>Окремий розділ об’єднує футбольні матчі, турніри з настільного тенісу, виступи з черлідингу та офіційні спортивні заходи.</p>
        <a class="text-link" href={withBase('/zmahannia/')}>Перейти до змагань →</a>
      </div>
    </div>
  </section>

  <section class="section section--tint news-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Офіційний Telegram-канал</p>
        <h2>Новини закладу</h2>
        <p>Розділ дублює перевірені публікації офіційного Telegram-каналу МДЮСШ і зберігає їх на сайті як доступний архів.</p>
      </div>
      <div class="news-grid">
        {latestNews.map((entry) => (
          <article class="news-card">
            <a class="news-card-media" href={withBase(`/novyny/${entry.id}/`)} aria-label={`Читати: ${entry.data.title}`}>
              <img src={withBase(entry.data.cover)} alt={entry.data.coverAlt} width="1600" height="900" loading="lazy" />
            </a>
            <div class="news-card-body">
              <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              <h3><a href={withBase(`/novyny/${entry.id}/`)}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
              <a class="text-link" href={withBase(`/novyny/${entry.id}/`)}>Читати новину →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="section-note">Першоджерело оперативних публікацій — офіційний Telegram-канал закладу.</p>
    </div>
  </section>

  <section class="section band next-step-section">
    <div class="container next-step-inner">
      <div><p class="eyebrow">Відкритість</p><h2>Документи закладу у відкритому доступі</h2></div>
      <div class="next-step-copy">
        <p>На сайті публікуються установчі, організаційні, освітні та інші відкриті документи. Фінансові документи до публічного каталогу не включаються.</p>
        <a class="button" href={withBase('/dokumenty/')}>Відкрити документи <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
