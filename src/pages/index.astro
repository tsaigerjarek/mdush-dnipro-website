---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const latestNews = (await getCollection('news', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="МДЮСШ Дніпро — офіційний сайт"
  description="Офіційний сайт МДЮСШ Дніпро: футбол, настільний теніс і черліденг, набір 2026/2027, вступ, змагання, новини, документи та контакти."
  fullWidth
>
  <section class="hero hero--sports">
    <div class="hero-background" aria-hidden="true">
      <img
        src={withBase('/media/hero/hero-mdush-home-bg.png')}
        alt=""
        width="1366"
        height="768"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Набір відкрито • Сезон 2026/2027</span>
        </div>
        <p class="eyebrow">КОМУНАЛЬНИЙ ПОЗАШКІЛЬНИЙ НАВЧАЛЬНИЙ ЗАКЛАД</p>
        <h1>МДЮСШ Дніпро з ігрових видів спорту</h1>
        <p class="hero-description">
          Офіційний набір до спортивних відділень закладу позашкільної освіти Дніпровської міської ради на сезон 2026/2027. Підготовка за напрямами: футбол, настільний теніс та черліденг.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="https://forms.gle/mdush-dnipro-2026" target="_blank" rel="noopener noreferrer">
            Подати заявку на вступ ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <nav class="about-social-bar" aria-label="Офіційні соціальні мережі МДЮСШ Дніпро">
    <div class="container about-social-inner">
      <span class="about-social-title">МДЮСШ ДНІПРО у соціальних мережах</span>
      <ul class="about-hero-social-links">
        <li><a class="about-hero-social-link" href="https://t.me/mdush_dnipro_official" target="_blank" rel="noopener noreferrer" aria-label="Офіційний Telegram МДЮСШ Дніпро"><img src={withBase('/media/social/telegram.png')} alt="" width="360" height="360" /></a></li>
        <li><a class="about-hero-social-link" href="https://www.instagram.com/mdush_official_dnipro/" target="_blank" rel="noopener noreferrer" aria-label="Офіційний Instagram МДЮСШ Дніпро"><img src={withBase('/media/social/instagram.png')} alt="" width="360" height="360" /></a></li>
        <li><a class="about-hero-social-link" href="https://www.youtube.com/&#64;mdush_official_dnipro" target="_blank" rel="noopener noreferrer" aria-label="Офіційний YouTube МДЮСШ Дніпро"><img src={withBase('/media/social/youtube.png')} alt="" width="360" height="360" /></a></li>
        <li><a class="about-hero-social-link" href="https://www.tiktok.com/&#64;mdush_official_dnipro?_t=8oGa0bOeSf7&amp;_r=1" target="_blank" rel="noopener noreferrer" aria-label="Офіційний TikTok МДЮСШ Дніпро"><img src={withBase('/media/social/tiktok.png')} alt="" width="360" height="360" /></a></li>
        <li><a class="about-hero-social-link" href="https://www.facebook.com/mdush.ivs/" target="_blank" rel="noopener noreferrer" aria-label="Офіційний Facebook МДЮСШ Дніпро"><img src={withBase('/media/social/facebook.png')} alt="" width="360" height="360" /></a></li>
      </ul>
    </div>
  </nav>

  <section id="about" class="section section--tint home-official-section" aria-labelledby="about-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <h2 id="about-title">Про заклад</h2>
        <p>Комунальний заклад позашкільної освіти.</p>
        <p>Міська дитячо-юнацька спортивна школа з ігрових видів спорту Дніпровської міської ради.</p>
        <p>Заклад забезпечує спортивно-виховну підготовку за 3 Основними напрямами:</p>
        <ul class="about-specializations">
          <li>Основний напрям — футбол (філії, юнацькі збірні, U19, ЖФК);</li>
          <li>Другий напрям — настільний теніс (хлопці та дівчата);</li>
          <li>Третій напрям — черліденг (Minis, Kids, Juniors, Adults).</li>
        </ul>
      </div>
      <dl class="home-facts" aria-label="Ключова інформація про заклад">
        <div><dt>01</dt><dd>Позашкільний спортивно-виховний заклад міста Дніпро</dd></div>
        <div><dt>02</dt><dd>Спортивне виховання молоді та підліткові збірні</dd></div>
        <div><dt>03</dt><dd>Спортивні напрями підготовки: Футбол, Настільний теніс, Черліденг</dd></div>
      </dl>
    </div>
  </section>

  <section id="sports-education" class="section section--paper home-sports-section" aria-labelledby="sports-title">
    <div class="container">
      <div class="section-heading home-section-heading">
        <p class="eyebrow">Спортивне виховання • Сезон 2026/2027</p>
        <h2 id="sports-title">Спортивні відділення закладу</h2>
      </div>

      <!-- Футбол -->
      <article class="sports-branch-card home-sport-card--dark" style="margin-bottom: 2.5rem; padding: 1.75rem; border-radius: 1rem; background: var(--green-950); color: var(--paper);">
        <p class="direction-role" style="color: #b9d4c7;">01 / Основний напрям</p>
        <h3 style="color: var(--paper); font-size: 2rem; margin-bottom: 0.5rem;">Футбол</h3>
        <p style="color: #d6eee1; max-width: 48rem;">
          Багатоступенева система футбольної підготовки від початкового етапу до старших юнацьких збірних та жіночного футболу.
        </p>

        <!-- 4 Вкладки футболу -->
        <div class="sports-tabs-wrapper">
          <input type="radio" name="football-main-tab" id="fb-tab-1" checked class="tab-input" />
          <input type="radio" name="football-main-tab" id="fb-tab-2" class="tab-input" />
          <input type="radio" name="football-main-tab" id="fb-tab-3" class="tab-input" />
          <input type="radio" name="football-main-tab" id="fb-tab-4" class="tab-input" />

          <div class="sports-nav-labels" role="tablist">
            <label for="fb-tab-1" class="sports-nav-label">1. Філії (Початковий етап)</label>
            <label for="fb-tab-2" class="sports-nav-label">2. Збірні юнаки (Молодші)</label>
            <label for="fb-tab-3" class="sports-nav-label">3. Збірні (Старші)</label>
            <label for="fb-tab-4" class="sports-nav-label">4. ЖФК (Дівочі групи)</label>
          </div>

          <div class="tab-panels-group">
            <!-- Панель 1: Філії -->
            <div class="tab-panel-content panel-fb-1">
              <div class="age-card">
                <h4>Філії (Початковий етап): 2015–2019 р.н. / U6–U9</h4>
                <p class="age-card-meta">
                  <strong>Тренери:</strong> Фетісов Є. В., Сосна І. Р., Кравченко О. І. | <strong>Воротарі:</strong> Бобровський А. С.
                </p>
                <p>Початкове футбольне виховання молодших вікових груп у районах та філіях міста. Розвиток техніки, координації та любов до гри.</p>
                
                <div class="subtabs-container">
                  <input type="radio" name="f1-sub" id="f1-sub-players" checked class="subtab-input" />
                  <input type="radio" name="f1-sub" id="f1-sub-tournaments" class="subtab-input" />
                  <input type="radio" name="f1-sub" id="f1-sub-media" class="subtab-input" />
                  <input type="radio" name="f1-sub" id="f1-sub-achieve" class="subtab-input" />

                  <div class="subtab-labels">
                    <label for="f1-sub-players" class="subtab-btn">Гравці</label>
                    <label for="f1-sub-tournaments" class="subtab-btn">Турніри</label>
                    <label for="f1-sub-media" class="subtab-btn">Медіа</label>
                    <label for="f1-sub-achieve" class="subtab-btn">Досягнення</label>
                  </div>

                  <div class="subtab-panels">
                    <div class="subtab-panel-content subpanel-players">
                      <p>Склади навчальних груп філій U6–U9 (вихованці 2015–2019 р.н.). Групи формуються за місцем тренувань без публікації персональних даних неповнолітніх.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-tournaments">
                      <p>Внутрішні дитячі турніри МДЮСШ, товариські матчі та міські фестивалі футболу для наймолодших вихованців.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-media">
                      <p>Фотозвіти перших тренувань, відеоогляди дитячих фестивалів та фотогалереї філій.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-achieve">
                      <p>Перші дипломи, відзнаки за участь у міських турнірах та спортивний розвиток молодих футболістів.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Панель 2: Збірні юнаки (Молодші) -->
            <div class="tab-panel-content panel-fb-2">
              <div class="age-card">
                <h4>Збірні юнаки (Молодші): 2010–2017 р.н. / U10–U17 з розбивкою по роках</h4>
                <p class="age-card-meta">
                  <strong>Тренерський склад:</strong> Федотов, Іванющенко, Даренко, Шевченко П., Фетісов, Сосна, Шевченко К., Димарчук, Лусь, Волівач, Нікітенков, Коряковцев, Шарко, Кушнір.<br />
                  <strong>Тренери воротарів:</strong> Кулько, Бобровський, Гончаров, Баркар.
                </p>

                <div class="age-cards-grid">
                  <div class="age-card" style="background: var(--canvas);">
                    <h5>U10 (2017 р.н.) & U11 (2016 р.н.)</h5>
                    <p class="age-card-meta">Тренери: Федотов В. Ю., Кушнір А. А., Іванющенко В. В., Шарко О. В. | Воротарі: Баркар М. О.</p>
                  </div>
                  <div class="age-card" style="background: var(--canvas);">
                    <h5>U12 (2015 р.н.) & U13 (2014 р.н.)</h5>
                    <p class="age-card-meta">Тренери: Даренко В. В., Коряковцев О. В., Шевченко П. В., Нікітенков Д. В., Лусь С. П. | Воротарі: Баркар М. О., Гончаров М. А.</p>
                  </div>
                  <div class="age-card" style="background: var(--canvas);">
                    <h5>U14 (2013 р.н.) & U15 (2012 р.н.)</h5>
                    <p class="age-card-meta">Тренери: Фетісов Є. В., Сосна І. Р., Шевченко К. В., Димарчук О. А., Волівач О. І. | Воротарі: Бобровський А. С.</p>
                  </div>
                  <div class="age-card" style="background: var(--canvas);">
                    <h5>U16 (2011 р.н.) & U17 (2010 р.н.)</h5>
                    <p class="age-card-meta">Тренери: Шевченко К. В., Лусь С. П., Федотов В. Ю., Волівач О. І. | Воротарі: Бобровський А. С., Кулько А. А.</p>
                  </div>
                </div>

                <div class="subtabs-container">
                  <input type="radio" name="f2-sub" id="f2-sub-players" checked class="subtab-input" />
                  <input type="radio" name="f2-sub" id="f2-sub-tournaments" class="subtab-input" />
                  <input type="radio" name="f2-sub" id="f2-sub-media" class="subtab-input" />
                  <input type="radio" name="f2-sub" id="f2-sub-achieve" class="subtab-input" />

                  <div class="subtab-labels">
                    <label for="f2-sub-players" class="subtab-btn">Гравці</label>
                    <label for="f2-sub-tournaments" class="subtab-btn">Турніри</label>
                    <label for="f2-sub-media" class="subtab-btn">Медіа</label>
                    <label for="f2-sub-achieve" class="subtab-btn">Досягнення</label>
                  </div>

                  <div class="subtab-panels">
                    <div class="subtab-panel-content subpanel-players">
                      <p>Заявкові списки команд U10–U17 МДЮСШ Дніпро. Регулярні тренувальні збори та селекція кращих вихованців міста.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-tournaments">
                      <p>Участь у Дитячо-юнацькій футбольній лізі України (ДЮФЛУ), чемпіонатах Дніпропетровської області та кубках міста.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-media">
                      <p>Огляди ключових моментів ігрових турів, огляди голів та офіційні фоторепортажі матчів ДЮФЛУ.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-achieve">
                      <p>Призові місця у вищій та першій лігах ДЮФЛУ, кубкові трофеї та підготовка кандидатів до збірних команд.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Панель 3: Збірні (Старші) -->
            <div class="tab-panel-content panel-fb-3">
              <div class="age-card">
                <h4>Збірні (Старші): 2008–2009 р.н. / U19</h4>
                <p class="age-card-meta">
                  <strong>Тренери:</strong> Волівач О. І., Кравченко О. І. | <strong>Воротарі:</strong> Кулько А. А.
                </p>
                <p>Випускні вікові групи U19. Фінішний етап академічної підготовки та перехід у дорослий аматорський та професійний футбол.</p>

                <div class="subtabs-container">
                  <input type="radio" name="f3-sub" id="f3-sub-players" checked class="subtab-input" />
                  <input type="radio" name="f3-sub" id="f3-sub-tournaments" class="subtab-input" />
                  <input type="radio" name="f3-sub" id="f3-sub-media" class="subtab-input" />
                  <input type="radio" name="f3-sub" id="f3-sub-achieve" class="subtab-input" />

                  <div class="subtab-labels">
                    <label for="f3-sub-players" class="subtab-btn">Гравці</label>
                    <label for="f3-sub-tournaments" class="subtab-btn">Турніри</label>
                    <label for="f3-sub-media" class="subtab-btn">Медіа</label>
                    <label for="f3-sub-achieve" class="subtab-btn">Досягнення</label>
                  </div>

                  <div class="subtab-panels">
                    <div class="subtab-panel-content subpanel-players">
                      <p>Команда U19 у складі 22 гравців 2008–2009 р.н. з можливістю підсилення вихованцями суміжних років.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-tournaments">
                      <p>Всеукраїнські юнацькі турніри U19, Чемпіонат міста Дніпро серед дорослих та обласні кубкові змагання.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-media">
                      <p>Відеозаписи повних матчів, аналітичні огляди тактики та інтерв'ю старших тренерів.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-achieve">
                      <p>Виховання професійних кадрів, переходи випускників до клубів УПЛ, Першої/Другої ліг та аматорських команд.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Панель 4: ЖФК -->
            <div class="tab-panel-content panel-fb-4">
              <div class="age-card">
                <h4>ЖФК (Дівочі групи): WU10–WU15 / 2011–2015 р.н.</h4>
                <p class="age-card-meta">
                  <strong>Тренери:</strong> Кудзієв Р. Г., Бєлік В. В., Кудзієва О. Ю.
                </p>
                <p>Спеціалізоване відділення дівочого футболу. Формування команд WU10, WU12, WU15 для участі у профільних жіночих турнірах.</p>

                <div class="subtabs-container">
                  <input type="radio" name="f4-sub" id="f4-sub-players" checked class="subtab-input" />
                  <input type="radio" name="f4-sub" id="f4-sub-tournaments" class="subtab-input" />
                  <input type="radio" name="f4-sub" id="f4-sub-media" class="subtab-input" />
                  <input type="radio" name="f4-sub" id="f4-sub-achieve" class="subtab-input" />

                  <div class="subtab-labels">
                    <label for="f4-sub-players" class="subtab-btn">Гравці</label>
                    <label for="f4-sub-tournaments" class="subtab-btn">Турніри</label>
                    <label for="f4-sub-media" class="subtab-btn">Медіа</label>
                    <label for="f4-sub-achieve" class="subtab-btn">Досягнення</label>
                  </div>

                  <div class="subtab-panels">
                    <div class="subtab-panel-content subpanel-players">
                      <p>Дівочі футбольні команди ЖФК МДЮСШ вікових груп WU10 (2014–2015 р.н.) та WU15 (2011–2013 р.н.).</p>
                    </div>
                    <div class="subtab-panel-content subpanel-tournaments">
                      <p>Чемпіонат України серед дівочих команд WU15/WU13, всеукраїнські турніри та товариські матчі.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-media">
                      <p>Фотоісторії команди, хайлайти ігор ЖФК та репортажі з виїзних турнірів.</p>
                    </div>
                    <div class="subtab-panel-content subpanel-achieve">
                      <p>Медалі Всеукраїнських дівочих турнірів, підготовка гравчих для молодіжних дівочих збірних України.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Настільний теніс -->
      <article class="sports-branch-card home-sport-card--warm" style="margin-bottom: 2.5rem; padding: 1.75rem; border-radius: 1rem; background: var(--warm); border: 1px solid var(--line);">
        <p class="direction-role">02 / Другий напрям</p>
        <h3 style="color: var(--green-950); font-size: 2rem; margin-bottom: 0.5rem;">Настільний теніс</h3>
        <p style="color: var(--muted); max-width: 48rem;">
          Тренери: <strong>Кудзієв Р. Г., Кудзієва О. Ю.</strong><br />
          Спортивна підготовка юнаків та дівчат, розвиток реакції, координації, витривалості та вихід на міські й національні рейтингові турніри.
        </p>

        <div class="sports-tabs-wrapper">
          <input type="radio" name="tt-main-tab" id="tt-tab-boys" checked class="tab-input" />
          <input type="radio" name="tt-main-tab" id="tt-tab-girls" class="tab-input" />

          <div class="sports-nav-labels" role="tablist">
            <label for="tt-tab-boys" class="sports-nav-label">Хлопці (Категорії до 11, 12–14, 15–18 років)</label>
            <label for="tt-tab-girls" class="sports-nav-label">Дівчата (Категорії до 11, 12–14, 15–18 років)</label>
          </div>

          <div class="tab-panels-group">
            <div class="tab-panel-content panel-tt-boys">
              <div class="age-card">
                <h4>Відділення настільного тенісу — Хлопці</h4>
                <p class="age-card-meta">Групи: До 11 років (2015 р.н. і мол.), 12–14 років (2012–2014 р.н.), 15–18 років (2008–2011 р.н.).</p>
                <div class="subtabs-container">
                  <input type="radio" name="tt-sub" id="tt-sub-players" checked class="subtab-input" />
                  <input type="radio" name="tt-sub" id="tt-sub-tournaments" class="subtab-input" />
                  <input type="radio" name="tt-sub" id="tt-sub-media" class="subtab-input" />
                  <input type="radio" name="tt-sub" id="tt-sub-achieve" class="subtab-input" />

                  <div class="subtab-labels">
                    <label for="tt-sub-players" class="subtab-btn">Гравці</label>
                    <label for="tt-sub-tournaments" class="subtab-btn">Турніри</label>
                    <label for="tt-sub-media" class="subtab-btn">Медіа</label>
                    <label for="tt-sub-achieve" class="subtab-btn">Досягнення</label>
                  </div>

                  <div class="subtab-panels">
