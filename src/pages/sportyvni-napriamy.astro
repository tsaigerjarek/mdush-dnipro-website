---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import { getPublicCoaches, type Coach } from '../data/coaches';
import { getPublicPlayers } from '../data/players';
import PlayerCard from '../components/players/PlayerCard.astro';

interface AgeGroupItem {
  id: string;
  title: string;
  birthYear: string;
  coaches: Coach[];
}

const footballStages = [
  {
    stageTitle: 'Базова підготовка',
    stageAge: 'U9–U13',
    groups: [
      { id: 'u9', title: 'U9', birthYear: '2018 р.н.', coaches: getPublicCoaches('football', 'U9') },
      { id: 'u10', title: 'U10', birthYear: '2017 р.н.', coaches: getPublicCoaches('football', 'U10') },
      { id: 'u11', title: 'U11', birthYear: '2016 р.н.', coaches: getPublicCoaches('football', 'U11') },
      { id: 'u12', title: 'U12', birthYear: '2015 р.н.', coaches: getPublicCoaches('football', 'U12') },
      { id: 'u13', title: 'U13', birthYear: '2014 р.н.', coaches: getPublicCoaches('football', 'U13') },
    ] as AgeGroupItem[],
  },
  {
    stageTitle: 'Спеціалізована підготовка',
    stageAge: 'U14–U17',
    groups: [
      { id: 'u14', title: 'U14', birthYear: '2013 р.н.', coaches: getPublicCoaches('football', 'U14') },
      { id: 'u15', title: 'U15', birthYear: '2012 р.н.', coaches: getPublicCoaches('football', 'U15') },
      { id: 'u16', title: 'U16', birthYear: '2011 р.н.', coaches: getPublicCoaches('football', 'U16') },
      { id: 'u17', title: 'U17', birthYear: '2010 р.н.', coaches: getPublicCoaches('football', 'U17') },
    ] as AgeGroupItem[],
  },
  {
    stageTitle: 'Завершальний етап',
    stageAge: 'ЗБІРНА U19',
    groups: [
      { id: 'u19', title: 'ЗБІРНА U19', birthYear: '2008–2009 р.н.', coaches: getPublicCoaches('football', 'ЗБІРНА U19') },
    ] as AgeGroupItem[],
  },
];

const girlsGroups: AgeGroupItem[] = [
  { id: 'girls-u15', title: 'U15', birthYear: '2012 р.н.', coaches: [] },
  { id: 'girls-u13', title: 'U13', birthYear: '2014 р.н.', coaches: [] },
  { id: 'girls-u12', title: 'U12', birthYear: '2015 р.н.', coaches: [] },
  { id: 'girls-u10', title: 'U10', birthYear: '2017 р.н.', coaches: [] },
];
---

<BaseLayout
  title="Напрями спортивного виховання — МДЮСШ Дніпро"
  description="Спортивні напрями МДЮСШ Дніпро: футбол, настільний теніс, черліденг і підтверджені навчально-тренувальні бази."
  fullWidth={true}
>
  <header class="page-intro sports-page-hero">
    <div class="container sports-container">
      <h1>Напрями спортивного виховання</h1>
      <div class="sports-tablist" role="tablist" aria-label="Спортивні напрями">
        <button type="button" role="tab" id="tab-football" aria-controls="panel-football" aria-selected="true" class="sports-tab active">Футбол</button>
        <button type="button" role="tab" id="tab-table-tennis" aria-controls="panel-table-tennis" aria-selected="false" class="sports-tab" tabindex="-1">Настільний теніс</button>
        <button type="button" role="tab" id="tab-cheerleading" aria-controls="panel-cheerleading" aria-selected="false" class="sports-tab" tabindex="-1">Черліденг</button>
      </div>
    </div>
  </header>

  <section class="section section--paper sports-main-section" aria-label="Спортивні напрями закладу">
    <div class="container sports-container">
      <!-- Панель: Футбол -->
      <div id="panel-football" role="tabpanel" aria-labelledby="tab-football" class="sports-panel active">
        <div class="sports-football-panel-wrapper">
          <div class="sports-football-panel-header">
            <h2 id="football-title">Футбол</h2>
            <img class="sports-football-art" src={withBase('/media/identity/athlete-football.png')} alt="" width="1511" height="1660" loading="lazy" />
          </div>

          <div class="sports-football-stages">
            {footballStages.map((stage) => (
              <section class="sports-football-stage" aria-label={`${stage.stageTitle} (${stage.stageAge})`}>
                <div class="sports-stage-header">
                  <h3>{stage.stageTitle}</h3>
                  <span class="sports-stage-badge">{stage.stageAge}</span>
                </div>
                <div class="sports-age-cards-grid">
                  {stage.groups.map((group) => (
                    <article class="sports-age-card">
                      <header class="sports-age-card-header">
                        <h4 class="sports-age-card-title">{group.title}</h4>
                        <span class="sports-age-card-year">{group.birthYear}</span>
                      </header>
                      <div class="sports-age-card-body">
                        <h5 class="sports-coaches-label">Тренерський склад</h5>
                        <ul class="sports-coaches-list">
                          {group.coaches.map((coach) => (
                            <li class="sports-coach-row">
                              <div class="sports-coach-avatar">
                                {coach.photo ? (
                                  <img src={withBase(coach.photo)} alt={coach.name} width="48" height="60" loading="lazy" />
                                ) : (
                                  <div class="sports-coach-placeholder" aria-label="Фото готується">
                                    <span>Фото готується</span>
                                  </div>
                                )}
                              </div>
                              <div class="sports-coach-details">
                                <span class="sports-coach-name">{coach.name}</span>
                                <span class={`sports-coach-role ${coach.role === 'Тренер воротарів' ? 'sports-coach-role--gk' : ''}`}>{coach.role}</span>
                              </div>
                            </li>
                          ))}
                        </ul>

                        <div class="sports-roster-section">
                          <h5 class="sports-roster-label">Склад вихованців</h5>
                          {getPublicPlayers(group.title).length > 0 ? (
                            <div class="sports-players-grid">
                              {getPublicPlayers(group.title).map((player) => (
                                <PlayerCard player={player} />
                              ))}
                            </div>
                          ) : (
                            <p class="sports-roster-empty">Склад вихованців готується до публікації.</p>
                          )}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}

            <!-- Дівочі групи підготовки -->
            <section class="sports-football-stage sports-football-stage--girls" aria-label="Дівочі групи підготовки">
              <div class="sports-stage-header">
                <h3>Дівочі групи підготовки</h3>
              </div>
              <div class="sports-age-cards-grid">
                {girlsGroups.map((group) => (
                  <article class="sports-age-card">
                    <header class="sports-age-card-header">
                      <h4 class="sports-age-card-title">{group.title}</h4>
                      <span class="sports-age-card-year">{group.birthYear}</span>
                    </header>
                    <div class="sports-age-card-body">
                      <h5 class="sports-coaches-label">Тренерський склад</h5>
                      {group.coaches.length > 0 ? (
                        <ul class="sports-coaches-list">
                          {group.coaches.map((coach) => (
                            <li class="sports-coach-row">
                              <div class="sports-coach-avatar">
                                {coach.photo ? (
                                  <img src={withBase(coach.photo)} alt={coach.name} width="48" height="60" loading="lazy" />
                                ) : (
                                  <div class="sports-coach-placeholder" aria-label="Фото готується">
                                    <span>Фото готується</span>
                                  </div>
                                )}
                              </div>
                              <div class="sports-coach-details">
                                <span class="sports-coach-name">{coach.name}</span>
                                <span class={`sports-coach-role ${coach.role === 'Тренер воротарів' ? 'sports-coach-role--gk' : ''}`}>{coach.role}</span>
                              </div>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="sports-coaches-pending">Тренерський склад групи уточнюється.</p>
                      )}

                      <div class="sports-roster-section">
                        <h5 class="sports-roster-label">Склад вихованців</h5>
                        {getPublicPlayers(group.title).length > 0 ? (
                          <div class="sports-players-grid">
                            {getPublicPlayers(group.title).map((player) => (
                              <PlayerCard player={player} />
                            ))}
                          </div>
                        ) : (
                          <p class="sports-roster-empty">Склад вихованців готується до публікації.</p>
                        )}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          </div>
        </div>
      </div>

      <!-- Панель: Настільний теніс -->
      <div id="panel-table-tennis" role="tabpanel" aria-labelledby="tab-table-tennis" class="sports-panel" hidden>
        <div class="sports-panel-layout sports-panel-layout--tennis">
          <div class="sports-panel-heading">
            <h2 id="table-tennis-title">Настільний теніс</h2>
            <p>Спортивна підготовка, розвиток індивідуальної техніки, реакції, координації та змагальна практика вихованців.</p>
            <a class="button button-outline" href={withBase('/trenerskyi-sklad/#table-tennis')}>Переглянути тренерський склад</a>
          </div>
          <img class="sports-panel-art" src={withBase('/media/identity/athlete-tennis.png')} alt="" width="1693" height="1693" loading="lazy" />
          <div class="sports-panel-content">
            <article class="sports-panel-card">
              <h3>Навчально-тренувальні бази</h3>
              <ul class="sports-panel-facilities-list">
                <li><strong>СК «Старт»</strong><span>пр. Олександра Поля, 50д</span></li>
                <li><strong>Спортивний зал «Велика гра»</strong><span>вул. Сімферопольська, 17</span></li>
                <li><strong>КЗО «СЗШ № 80» ДМР</strong><span>вул. Комбрига Петрова, 31</span></li>
                <li><strong>КЗО НВО № 28</strong><span>вул. Володі Дубініна, 12</span></li>
                <li><strong>КЗО «СЗШ № 45» ДМР</strong><span>вул. С. Ковалевської, 88а</span></li>
                <li><strong>КЗО «СЗШ № 19» ДМР</strong><span>вул. Володимира Великого, 13а</span></li>
              </ul>
            </article>
          </div>
        </div>
      </div>

      <!-- Панель: Черліденг -->
      <div id="panel-cheerleading" role="tabpanel" aria-labelledby="tab-cheerleading" class="sports-panel" hidden>
        <div class="sports-panel-layout sports-panel-layout--cheerleading">
          <div class="sports-panel-heading">
            <h2 id="cheerleading-title">Черліденг</h2>
            <p>Самостійний спортивний напрям МДЮСШ, розвиток фізичної підготовки, пластики, акробатичних навичок та виступи.</p>
            <a class="button button-outline" href={withBase('/trenerskyi-sklad/#cheerleading')}>Переглянути тренерський склад</a>
          </div>
          <img class="sports-panel-art" src={withBase('/media/identity/athlete-cheerleading.png')} alt="" width="1434" height="1434" loading="lazy" />
          <div class="sports-panel-content">
            <article class="sports-panel-card">
              <h3>Навчально-тренувальні бази</h3>
              <ul class="sports-panel-facilities-list">
                <li><strong>КЗО «ССЗШ № 126» ДМР</strong><span>вул. Козакевича, 7</span></li>
                <li><strong>КЗО «СЗШ № 31» ДМР</strong><span>вул. Фабрично-заводська, 22</span></li>
                <li><strong>КЗО «СЗШ № 74» ДМР</strong><span>вул. Караваєва, 60</span></li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Спільна секція: Навчально-тренувальний процес -->
  <section class="section section--paper sports-preparation-section" aria-labelledby="preparation-title">
    <div class="container sports-container">
      <div class="section-heading">
        <h2 id="preparation-title">Як побудована спортивна підготовка</h2>
      </div>
      <ol class="sports-preparation-steps">
        <li><article><h3>Вибір спортивного напряму</h3></article></li>
        <li><article><h3>Визначення відповідної групи</h3></article></li>
        <li><article><h3>Систематичний тренувальний процес</h3></article></li>
        <li><article><h3>Участь у змаганнях і спортивних заходах</h3></article></li>
      </ol>
    </div>
  </section>

  <!-- Спільна секція: Тренерський склад -->
  <section class="section section--tint sports-coaches-section" aria-labelledby="coaches-title">
    <div class="container sports-container sports-coaches-card">
      <div>
        <h2 id="coaches-title">Тренерський склад</h2>
      </div>
      <a class="button" href={withBase('/trenerskyi-sklad/')}>Переглянути тренерський склад</a>
    </div>
  </section>

  <!-- Спільна секція: Фінальний CTA -->
  <section class="section section--paper sports-admission-cta-section" aria-labelledby="sports-admission-title">
    <div class="container sports-container sports-admission-cta">
      <div>
        <h2 id="sports-admission-title">Оберіть спортивний напрям</h2>
      </div>
      <div class="actions sports-admission-actions">
        <a class="button" href={withBase('/yak-vstupyty/')}>Умови вступу</a>
        <a class="button button-outline" href={withBase('/kontakty/')}>Контакти</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
      const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));

      function activateTab(tab, setFocus) {
        if (!tab) return;
        const targetId = tab.getAttribute('aria-controls');

        tabs.forEach((t) => {
          const isSelected = t === tab;
          t.setAttribute('aria-selected', String(isSelected));
          t.setAttribute('tabindex', isSelected ? '0' : '-1');
          t.classList.toggle('active', isSelected);
        });

        panels.forEach((p) => {
          const isTarget = p.id === targetId;
          p.hidden = !isTarget;
          p.classList.toggle('active', isTarget);
        });

        if (setFocus) {
          tab.focus();
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          activateTab(tab, false);
        });

        tab.addEventListener('keydown', (e) => {
          let newIndex = index;
          if (e.key === 'ArrowRight') {
            newIndex = (index + 1) % tabs.length;
          } else if (e.key === 'ArrowLeft') {
            newIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (e.key === 'Home') {
            newIndex = 0;
          } else if (e.key === 'End') {
            newIndex = tabs.length - 1;
          } else {
            return;
          }
          e.preventDefault();
          activateTab(tabs[newIndex], true);
        });
      });

      function syncWithHash() {
        const hash = window.location.hash.replace('#', '');
        if (hash) {
          const matchingTab = tabs.find((t) => t.getAttribute('aria-controls') === `panel-${hash}` || t.id === `tab-${hash}`);
          if (matchingTab) {
            activateTab(matchingTab, false);
          }
        }
      }

      window.addEventListener('hashchange', syncWithHash);
      syncWithHash();
    })();
  </script>
</BaseLayout>
