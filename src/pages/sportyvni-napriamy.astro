---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Відділення — MDUSH Dnipro"
  description="Розділ зі спортивними відділеннями МДЮСШ Дніпро, який поетапно наповнюється перевіреними даними."
>
  <header class="page-intro">
    <p class="eyebrow">Спортивне життя</p>
    <h1>Відділення</h1>
    <p>Тут буде зібрано перевірену інформацію про спортивні відділення, тренерський склад, бази та розклад.</p>
  </header>
  <section class="section scaffold-section" aria-label="Майбутні матеріали розділу">
    <div class="scaffold-grid">
      <article class="scaffold-card"><span class="card-number">01</span><h2>Спортивні відділення</h2></article>
      <article class="scaffold-card"><span class="card-number">02</span><h2>Тренерський склад</h2></article>
      <article class="scaffold-card"><span class="card-number">03</span><h2>Бази та розклад</h2></article>
    </div>
  </section>
</BaseLayout>
