---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Спортивні напрями — MDUSH Dnipro" description="Спортивні напрями МДЮСШ Дніпро">
  <header class="page-intro"><p class="eyebrow">Програми закладу</p><h1>Спортивні напрями</h1><p>Єдина структура представлення футболу, настільного тенісу та черлідингу.</p></header>
  <section class="section"><div class="grid">
    <article class="card"><span class="card-number">01</span><h2>Футбол</h2><p>Команди, вікові групи й умови занять додамо після перевірки.</p></article>
    <article class="card"><span class="card-number">02</span><h2>Настільний теніс</h2><p>Відомості про напрям додамо після перевірки.</p></article>
    <article class="card"><span class="card-number">03</span><h2>Черлідинг</h2><p>Відомості про напрям додамо після перевірки.</p></article>
  </div></section>
</BaseLayout>
