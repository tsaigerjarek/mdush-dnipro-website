---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Як вступити — МДЮСШ Дніпро"
  description="Порядок звернення щодо вступу до МДЮСШ Дніпро: вибір спортивного напряму, вікові орієнтири, офіційні контакти та захист персональних даних."
  fullWidth={true}
>
  <header class="page-intro admission-page-hero">
    <div class="container admission-container">
      <h1>ВСТУП ДО ЗАКЛАДУ</h1>
    </div>
  </header>

  <!-- Секція: Кроки вступу -->
  <section class="section section--paper admission-section" aria-labelledby="admission-steps-title">
    <div class="container admission-container">
      <div class="section-heading">
        <h2 id="admission-steps-title">ІНФОРМАЦІЯ ДО ВСТУПУ</h2>
      </div>

      <div class="admission-steps-grid">
        <article class="admission-step-card">
          <h3>Оберіть спортивний напрям</h3>
          <a class="text-link" href={withBase('/sportyvni-napriamy/')}>Переглянути спортивні напрями →</a>
        </article>

        <article class="admission-step-card">
          <h3>УТОЧНЕННЯ ВІДПОВІДНО ДО ВІКОВОЇ ГРУПИ</h3>
        </article>

        <article class="admission-step-card">
          <h3>Зв’яжіться з адміністрацією</h3>
          <a class="text-link" href={withBase('/kontakty/')}>Відкрити контакти →</a>
        </article>

        <article class="admission-step-card">
          <h3>ДОКУМЕНТИ ДЛЯ ВСТУПУ</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- Секція: Вікові орієнтири для футболу -->
  <section class="section section--tint admission-age-section" aria-labelledby="age-guide-title">
    <div class="container admission-container">
      <div class="section-heading">
        <h2 id="age-guide-title">Футбол — ВІКОВІ ГРУПИ ЗАКЛАДУ</h2>
      </div>

      <div class="admission-age-guide-grid">
        <article class="admission-age-column">
          <h3>Базова підготовка</h3>
          <div class="admission-age-chips">
            <div class="admission-age-chip"><strong>U9</strong><span>2018 р.н.</span></div>
            <div class="admission-age-chip"><strong>U10</strong><span>2017 р.н.</span></div>
            <div class="admission-age-chip"><strong>U11</strong><span>2016 р.н.</span></div>
            <div class="admission-age-chip"><strong>U12</strong><span>2015 р.н.</span></div>
            <div class="admission-age-chip"><strong>U13</strong><span>2014 р.н.</span></div>
          </div>
        </article>

        <article class="admission-age-column">
          <h3>Спеціалізована підготовка</h3>
          <div class="admission-age-chips">
            <div class="admission-age-chip"><strong>U14</strong><span>2013 р.н.</span></div>
            <div class="admission-age-chip"><strong>U15</strong><span>2012 р.н.</span></div>
            <div class="admission-age-chip"><strong>U16</strong><span>2011 р.н.</span></div>
            <div class="admission-age-chip"><strong>U17</strong><span>2010 р.н.</span></div>
          </div>
        </article>

        <article class="admission-age-column">
          <h3>ЗБІРНА U19</h3>
          <div class="admission-age-chips">
            <div class="admission-age-chip"><strong>ЗБІРНА U19</strong><span>2008–2009 р.н.</span></div>
          </div>
        </article>
      </div>

      <p class="section-note" style="margin-top: 1.5rem;">Актуальний набір, можливість зарахування підтверджує адміністрація закладу.</p>

      <!-- Блок: Дівочий футбол -->
      <article class="admission-girls-block">
        <h3>Дівочий футбол</h3>
        <div class="admission-age-chips" style="margin: 0.85rem 0 1.25rem;">
          <div class="admission-age-chip"><strong>Дівочі групи</strong><span>U15/U13</span></div>
          <div class="admission-age-chip"><strong>Дівочі групи</strong><span>U10/U12</span></div>
        </div>
        <div class="actions">
          <a class="text-link" href={withBase('/trenerskyi-sklad/#football')}>Переглянути тренерський склад →</a>
        </div>
      </article>
    </div>
  </section>

  <!-- Секція: Безпека даних -->
  <section class="section section--paper admission-safety-section" aria-labelledby="admission-safety-title">
    <div class="container admission-container">
      <div class="admission-safety-card">
        <div>
          <h2 id="admission-safety-title">Сайт не збирає персональні дані дітей</h2>
        </div>
        <div>
          <p>На сайті немає онлайн-форм вступу, кабінету користувача або збору медичних документів. Персональні дані, медичні довідки та копії документів передаються лише за офіційною процедурою, яку окремо підтверджує адміністрація.</p>
          <p class="section-note">Розклад занять і прив’язку груп до конкретних баз на сайті не публікуємо.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Секція: Фінальний CTA -->
  <section class="section section--tint admission-cta-section" aria-labelledby="admission-cta-title">
    <div class="container admission-container">
      <div class="admission-cta-card">
        <div>
          <h2 id="admission-cta-title">Готові уточнити умови вступу?</h2>
        </div>
        <div class="actions admission-cta-actions">
          <a class="button" href={withBase('/kontakty/')}>Офіційні контакти</a>
          <a class="button button-outline" href={withBase('/sportyvni-napriamy/')}>Спортивні напрями</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
