---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Контакти — MDUSH Dnipro"
  description="Розділ з офіційними контактами МДЮСШ Дніпро, який поетапно наповнюється перевіреними даними."
>
  <header class="page-intro">
    <p class="eyebrow">Зв’язок із закладом</p>
    <h1>Контакти</h1>
    <p>Контактні дані, адреси та карта баз будуть додані після звірки з офіційними джерелами.</p>
  </header>
  <section class="section scaffold-section" aria-label="Майбутні матеріали розділу">
    <div class="scaffold-grid">
      <article class="scaffold-card"><span class="card-number">01</span><h2>Канали зв’язку</h2></article>
      <article class="scaffold-card"><span class="card-number">02</span><h2>Адреси</h2></article>
      <article class="scaffold-card"><span class="card-number">03</span><h2>Карта баз</h2></article>
    </div>
  </section>
</BaseLayout>
