import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Контакти — MDUSH Dnipro" description="Контакти МДЮСШ Дніпро">
  <header class="page-intro"><p class="eyebrow">Зв’язок із закладом</p><h1>Контакти</h1><p>Прототип сторінки для офіційної адреси, телефону, електронної пошти, графіка й маршрутів.</p></header>
  <section class="section"><div class="grid">
    <article class="card"><span class="card-number">01</span><h2>Зв’язок</h2><p>Перевірені телефон і пошта будуть додані окремо.</p></article>
    <article class="card"><span class="card-number">02</span><h2>Адреса</h2><p>Офіційну адресу буде перенесено з погоджених даних.</p></article>
    <article class="card"><span class="card-number">03</span><h2>Маршрут</h2><p>Легкі зовнішні посилання замість важкої вбудованої карти.</p></article>
  </div></section>
</BaseLayout>
