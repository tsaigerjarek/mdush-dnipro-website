---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoachCard from '../components/coaches/CoachCard.astro';
import {
  footballStaffGroups,
  getPublicCoaches,
} from '../data/coaches';
import { withBase } from '../lib/urls';

const publicTennisCoaches = getPublicCoaches('table-tennis');
const publicCheerCoaches = getPublicCoaches('cheerleading');
---

<BaseLayout
  title="Тренерський склад — МДЮСШ Дніпро"
  description="Тренери та фахівці МДЮСШ Дніпро, які забезпечують навчально-тренувальний процес у спортивних напрямах і вікових групах закладу."
>
  <header class="page-intro coach-page-hero">
    <p class="eyebrow">Команда фахівців</p>
    <h1>Тренерський склад</h1>
    <p class="page-lead">
      Тренери-викладачі та профільні фахівці МДЮСШ Дніпро, які забезпечують навчально-тренувальний процес за спортивними напрямами закладу.
    </p>

    <nav class="sports-anchor-nav coach-anchor-nav" aria-label="Навігація за спортивними напрямами">
      <a href="#football">Футбол</a>
      <a href="#table-tennis">Настільний теніс</a>
      <a href="#cheerleading">Черліденг</a>
    </nav>
  </header>

  <!-- Секція 1: Футбол -->
  <section id="football" class="section section--paper coaching-section" aria-labelledby="football-staff-title">
    <div class="container">
      <div class="section-heading coach-section-heading">
        <p class="eyebrow">Спортивний напрям</p>
        <h2 id="football-staff-title">Футбол</h2>
        <div class="sr-only">
          <h3>Футбол</h3>
        </div>
        <p class="section-lead">
          Тренерський супровід юнацьких та дівочих футбольних команд МДЮСШ Дніпро за віковими категоріями підготовки.
        </p>
      </div>

      <div class="coaching-staff-groups">
        {footballStaffGroups.map((group) => (
          <article class="coaching-group-block" aria-labelledby={`group-${group.id}`}>
            <header class="coaching-group-header">
              <div>
                <h4 id={`group-${group.id}`} class="coaching-group-title">{group.teamName}</h4>
              </div>
              <div class="coaching-group-badges">
                {group.birthYear && (
                  <span class="coaching-group-badge">{group.birthYear}</span>
                )}
              </div>
            </header>

            {group.description && (
              <p class="coaching-group-desc">{group.description}</p>
            )}

            {group.subgroups && group.subgroups.length > 0 ? (
              <div class="coaching-subgroups-container">
                {group.subgroups.map((sub) => (
                  <div class="coaching-subgroup-section">
                    <header class="coaching-subgroup-header">
                      <h5 class="coaching-subgroup-title">{sub.teamName}</h5>
                      <span class="coaching-group-badge">{sub.birthYear}</span>
                    </header>
                    <div class="coach-grid">
                      {sub.coaches.map((coach) => (
                        <CoachCard coach={coach} />
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : group.coaches.length > 0 ? (
              <div class="coach-grid">
                {group.coaches.map((coach) => (
                  <CoachCard coach={coach} />
                ))}
              </div>
            ) : (
              <div class="coaching-group-empty">
                <p class="coaching-group-empty-title">Тренерський склад групи готується до публікації.</p>
                <p class="coaching-group-empty-desc">Персональні картки фахівців будуть оприлюднені після звірки актуального складу.</p>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Секція 2: Настільний теніс -->
  <section id="table-tennis" class="section section--tint coaching-section" aria-labelledby="tennis-staff-title">
    <div class="container">
      <div class="section-heading coach-section-heading">
        <p class="eyebrow">Спортивний напрям</p>
        <h2 id="tennis-staff-title">Відділення настільного тенісу</h2>
        <div class="sr-only">
          <h3>Настільний теніс</h3>
        </div>
      </div>

      {publicTennisCoaches.length > 0 ? (
        <div class="coach-grid">
          {publicTennisCoaches.map((coach) => (
            <CoachCard coach={coach} />
          ))}
        </div>
      ) : (
        <article class="coaching-pending-card">
          <div class="coaching-pending-badge">Підготовка розділу</div>
          <h4>Інформація про тренерський склад готується до публікації</h4>
          <p>
            Відомості про тренерів-викладачів відділення настільного тенісу, навчальні групи та графік консультацій будуть опубліковані після верифікації адміністрацією закладу.
          </p>
          <div class="actions">
            <a class="button button-outline" href={withBase('/sportyvni-napriamy/#table-tennis')}>
              Про напрям настільного тенісу
            </a>
          </div>
        </article>
      )}
    </div>
  </section>

  <!-- Секція 3: Черліденг -->
  <section id="cheerleading" class="section section--paper coaching-section" aria-labelledby="cheer-staff-title">
    <div class="container">
      <div class="section-heading coach-section-heading">
        <p class="eyebrow">Спортивний напрям</p>
        <h2 id="cheer-staff-title">Відділення черліденгу</h2>
        <div class="sr-only">
          <h3>Черлідинг</h3>
        </div>
      </div>

      {publicCheerCoaches.length > 0 ? (
        <div class="coach-grid">
          {publicCheerCoaches.map((coach) => (
            <CoachCard coach={coach} />
          ))}
        </div>
      ) : (
        <article class="coaching-pending-card coaching-pending-card--warm">
          <div class="coaching-pending-badge">Підготовка розділу</div>
          <h4>Інформація про тренерський склад готується до публікації</h4>
          <p>
            Відомості про тренерський склад відділення черліденгу, вікові групи вихованок та спортивні програми підготовки будуть опубліковані після верифікації адміністрацією закладу.
          </p>
          <div class="actions">
            <a class="button button-outline" href={withBase('/sportyvni-napriamy/#cheerleading')}>
              Про напрям черліденгу
            </a>
          </div>
        </article>
      )}
    </div>
  </section>

  <!-- Блок переходів та зв'язку -->
  <section class="section section--tint coaching-footer-cta" aria-labelledby="coaching-contact-title">
    <div class="container coaching-cta-card">
      <div>
        <p class="eyebrow">Зворотний зв'язок</p>
        <h2 id="coaching-contact-title">Питання щодо тренувального процесу</h2>
        <p>
          З питань зарахування до груп, розкладу занять та взаємодії з тренерським складом звертайтеся до адміністрації закладу.
        </p>
      </div>
      <div class="actions coaching-cta-actions">
        <a class="button" href={withBase('/yak-vstupyty/')}>Умови вступу</a>
        <a class="button button-outline" href={withBase('/kontakty/')}>Контакти закладу</a>
      </div>
    </div>
  </section>
</BaseLayout>
